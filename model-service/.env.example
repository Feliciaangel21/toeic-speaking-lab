# Local model service. Copy this file to model-service/.env and keep it out of Git.
MODEL_SERVICE_TOKEN=change-me
WHISPER_CPP_BIN=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=/models/ggml-base.en.bin
WHISPER_CPP_THREADS=4

# Speech/text providers
ENABLE_SILERO=1
ENABLE_BGE=1
ENABLE_QWEN=1
ENABLE_QWEN_FEEDBACK=1
ENABLE_QWEN_LANGUAGE_ANALYSIS=1
BGE_MODEL=BAAI/bge-small-en-v1.5
QWEN_MODEL=Qwen/Qwen3-0.6B
HF_HOME=/models/huggingface

# Pronunciation is intentionally opt-in. Do not substitute Whisper accuracy for
# pronunciation quality. PRONUNCIATION_COMMAND should be a local adapter that
# accepts JSON on stdin and returns JSON on stdout (see docs/INFERENCE_PIPELINE_V3.md).
ENABLE_PRONUNCIATION=0
PRONUNCIATION_COMMAND=
PRONUNCIATION_TIMEOUT_SEC=180

# Supabase queue. SERVICE ROLE is allowed here only because this file stays on your laptop.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer a current Supabase secret key. Legacy service_role also works for now.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=speaking-recordings
ENABLE_LOCAL_RUNNER=1
