NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional backward-compatibility only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for the optional one-time question-bank seed script.
# Never expose a service-role key in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Keep these out of NEXT_PUBLIC_* variables.
# URL for the separate open-source evaluation service.
MODEL_SERVICE_URL=http://localhost:8100
# Optional shared token between Next.js and the model service.
MODEL_SERVICE_TOKEN=
