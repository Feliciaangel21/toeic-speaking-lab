NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional backward-compatibility only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required: /api/auth/signup uses this to create accounts already confirmed,
# because the project's built-in SMTP cannot deliver confirmation mail.
# Account creation returns 503 without it. Also used by the seed scripts.
# Server-side only — never expose a service-role key in browser code, and set
# it on your deploy host too, since this file is gitignored.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Keep these out of NEXT_PUBLIC_* variables.
# URL for the separate open-source evaluation service.
MODEL_SERVICE_URL=http://localhost:8100
# Optional shared token between Next.js and the model service.
MODEL_SERVICE_TOKEN=
a